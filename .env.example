# Set to true to enable the optional LLM-based AI-project-depth adjustment
# layered on top of the deterministic rubric. If false (default), the system
# runs fully deterministically and needs no API key.
USE_LLM=false

# Required only if USE_LLM=true. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional. Model name used for the LLM scoring adjustment.
LLM_MODEL=claude-sonnet-4-6

# Optional. Without a token, GitHub enrichment still works but is limited to
# ~60 unauthenticated requests/hour. A personal access token (no special
# scopes needed for public data) raises this to 5000/hour.
GITHUB_TOKEN=
